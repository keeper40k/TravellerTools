<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GearEditor</RootNamespace>
    <AssemblyName>GearEditor</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fundamentals\Fundamentals.csproj" />
    <ProjectReference Include="..\TravellerData\TravellerData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="JSON\gear.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="JSON\gearTypes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
